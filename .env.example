APP_NAME="Chat Bantuan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chat_bantuan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans (kosongkan bila belum punya akun; isi dari Dashboard Midtrans > Settings > Access Keys)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# Mode AI widget chat (opsional — atur juga di panel admin > Pengaturan):
# - Ollama (AI lokal): tidak perlu kunci apa pun.
# - Google Gemini: isi kunci dari Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=

# WhatsApp Cloud API (resmi Meta) — untuk balas chat WA otomatis.
# Isi dari dasbor developers.facebook.com > aplikasi Anda > WhatsApp.
# JANGAN kirim nilai-nilai ini lewat chat kepada siapa pun.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Kata rahasia bebas buatan Anda sendiri; tulis yang SAMA persis di dasbor Meta
# saat mendaftarkan webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret aplikasi Meta (opsional, untuk memeriksa tanda tangan webhook).
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v22.0
